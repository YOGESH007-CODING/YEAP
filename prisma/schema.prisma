// Prisma Schema — YEAP SRS Backend
// Rule: dueDate is indexed for O(log n) queue compilation queries.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled — app runtime
  directUrl = env("DIRECT_URL")     // non-pooled — migrations
}
// ─── User Model ─────────────────────────────────────────────────────────────
model User {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String?
  passwordHash      String?                       // Null for OAuth-only users
  provider          AuthProvider      @default(LOCAL)
  providerId        String?
  leetcodeUsername  String?           @unique   // Optional — verified post-OAuth
  telegramChatId    String?                     // For Telegram notification delivery
  deletedAt         DateTime?                   // Soft-deletion marker; active users have null
  tokenVersion      Int               @default(0) // Invalidates access tokens when incremented
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  problemProgresses ProblemProgress[]
  refreshTokens     RefreshToken[]
  companyTrackers   CompanyTracker[]
  mistakes          UserMistake[]
  topicMasteries    UserTopicMastery[]
  notes             UserNote[]
  streak            UserStreak?
  shareToken        String?           @unique
  shareEnabled      Boolean           @default(false)
  shareTrackerId    String?

  @@map("users")
  @@unique([provider, providerId])
  @@index([deletedAt])
}

// Per-user preparation plans. Progress is derived from ProblemProgress records
// and company-tagged Problems, so tracker state never duplicates SRS state.
model CompanyTracker {
  id                String   @id @default(cuid())
  userId            String
  companyName       String
  dailySolveGoal    Int      @default(3)
  dailyRevisionGoal Int      @default(5)
  weeklySolveGoal   Int      @default(15)
  isActive          Boolean  @default(true)
  lastActivityAt    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyName])
  @@index([userId, isActive])
  @@map("company_trackers")
}

// Registration details remain here until the email owner proves control of the
// inbox. This prevents unverified accounts from receiving sessions or tokens.
model EmailVerification {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String?
  leetcodeUsername String?
  codeHash         String
  expiresAt        DateTime
  attempts         Int      @default(0)
  lastSentAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([expiresAt])
  @@map("email_verifications")
}

// One-time OAuth reauthentication grants for account deletion. Secrets are
// stored only as SHA-256 hashes and every grant is single-use.
model AccountDeletionReauth {
  id            String       @id @default(cuid())
  userId        String
  provider      AuthProvider
  stateHash     String       @unique
  grantHash     String?
  expiresAt     DateTime
  completedAt   DateTime?
  usedAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([userId, expiresAt])
  @@map("account_deletion_reauth")
}

// Append-only from application code. It deliberately has no foreign key so
// the deletion evidence remains after related personal data is removed.
model AccountDeletionAudit {
  id            String   @id @default(cuid())
  userId        String
  requestId     String
  ipHash        String
  userAgent     String?
  occurredAt    DateTime @default(now())

  @@index([userId])
  @@index([occurredAt])
  @@map("account_deletion_audit")
}

// ─── Problem Model ───────────────────────────────────────────────────────────
model Problem {
  id          String            @id @default(cuid())
  slug        String            @unique     // LeetCode URL slug e.g. "two-sum"
  title       String
  difficulty  Difficulty
  topicTags   String[]                      // e.g. ["Array", "Hash Table"]
  companyTags String[]                      // e.g. ["Amazon", "Google"]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  progresses  ProblemProgress[]
  mistakes    UserMistake[]
  notes       UserNote[]

  @@index([companyTags], type: Gin)
  @@index([topicTags], type: Gin)

  // Trigram indexes backing the ILIKE '%term%' search (PERFORMANCE.md M4).
  // These must stay declared here even though the pg_trgm extension and the
  // indexes are created by 20260821000000_add_problem_search_trgm_indexes:
  // an index that exists only in raw migration SQL is invisible to
  // schema.prisma, so the next `prisma migrate dev` would generate a DROP for
  // it. `map:` pins the names to the ones that migration created.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "problems_title_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "problems_slug_trgm_idx")
  @@map("problems")
}

// ─── ProblemProgress Model (SM-2 State per User per Problem) ─────────────────
model ProblemProgress {
  id              String    @id @default(cuid())
  userId          String
  problemId       String

  // SM-2 State
  repetitions     Int       @default(0)           // n: number of successful reviews
  easinessFactor  Float     @default(2.5)          // EF: starts at 2.5 per SM-2 spec
  intervalDays    Int       @default(1)            // I: days until next review
  dueDate         DateTime  @default(now())        // Next scheduled review datetime

  // Audit
  lastReviewedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  // Constraints
  @@unique([userId, problemId])           // One progress record per user per problem
  @@index([dueDate])                      // Fast backlog queue compilation queries
  @@index([userId, dueDate])              // Compound index for per-user due queries
  @@map("problem_progresses")
}

// ─── Enums ───────────────────────────────────────────────────────────────────
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum MistakeType {
  LOGIC_ERROR
  EDGE_CASE
  WRONG_APPROACH
  TIME_COMPLEXITY
  MISREAD_PROBLEM
  FORGOT_PATTERN
  SYNTAX_SLIP
}

model UserMistake {
  id              String      @id @default(cuid())
  userId          String
  problemId       String
  topicName       String
  mistakeType     MistakeType
  description     String?
  createdAt       DateTime    @default(now())
  resolvedAt      DateTime?
  recurrenceCount Int         @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId, mistakeType])
  @@index([userId, topicName])
  @@map("user_mistakes")
}

model UserTopicMastery {
  id              String   @id @default(cuid())
  userId          String
  topicName       String
  masteryScore    Float    @default(0)
  totalAttempts   Int      @default(0)
  correctAttempts Int      @default(0)
  mistakeCount    Int      @default(0)
  lastPracticedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicName])
  @@index([userId, masteryScore])
  @@map("user_topic_masteries")
}

model UserNote {
  id            String   @id @default(cuid())
  userId        String
  problemId     String
  noteText      String
  importantFlag Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, importantFlag])
  @@map("user_notes")
}

model UserStreak {
  id                 String   @id @default(cuid())
  userId             String   @unique
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  lastStreakDate     DateTime?
  streakSafeToday    Boolean  @default(false)
  freezesAvailable   Int      @default(1)
  freezeRefreshedAt  DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

// ─── RefreshToken Model ──────────────────────────────────────────────────────
model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique             // The opaque refresh token string
  userId     String
  expiresAt  DateTime                     // 30-day expiry
  revoked    Boolean  @default(false)     // For manual revocation (logout)
  createdAt  DateTime @default(now())

  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])                    // For cleanup of expired tokens
  @@map("refresh_tokens")
}
