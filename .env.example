# Application
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3001

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:secret@localhost:5432/yeap_db?schema=public"

# Redis/BullMQ is disabled for the Vercel deployment.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Required: use a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-32-character-minimum-secret

# Resend (Email notification provider)
RESEND_API_KEY=re_your_api_key
NOTIFICATION_FROM_EMAIL=noreply@yeap.dev

# LeetCode (no auth needed — public GraphQL)
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
