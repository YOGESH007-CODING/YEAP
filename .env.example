# Environment
NODE_ENV="development"
PORT="3000"
ALLOWED_ORIGINS="http://localhost:3001,http://localhost:5173"

# Database (PostgreSQL - Neon / Local)
DATABASE_URL="Databse_URL"

# Connection pool sizing (optional). Appended to DATABASE_URL at startup, so the
# same build can run with a tiny pool on serverless and a larger one on the
# persistent worker. A value already present in DATABASE_URL wins.
#   Serverless / Vercel : DATABASE_CONNECTION_LIMIT=1  (or use PgBouncer/Accelerate)
#   Persistent host      : DATABASE_CONNECTION_LIMIT=10
DATABASE_CONNECTION_LIMIT=""
DATABASE_POOL_TIMEOUT=""

# Authentication
JWT_SECRET="your_jwt_secret_at_least_32_characters_long"
AUDIT_IP_SALT="a_separate_random_secret_at_least_32_characters_long"
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
BACKEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# Notifications (Resend)
RESEND_API_KEY="re_your_resend_api_key"
NOTIFICATION_FROM_EMAIL="____"
# Optional separate HMAC key for email OTPs. If omitted, JWT_SECRET is used.
EMAIL_VERIFICATION_SECRET="a_separate_random_secret_at_least_32_characters_long"

# External APIs
LEETCODE_GRAPHQL_URL="https://leetcode.com/graphql"

# Redis (Required for BullMQ)
REDIS_URL="redis_URL"

# Queue / Worker Configuration
ENABLE_WORKER="false"
QUEUE_CRON="0 4 * * *"
QUEUE_TIMEZONE="Asia/Kolkata"
